{
  "name": "pi-fixes",
  "version": "0.1.0",
  "description": "Bundled Pi workarounds (oversized-message guard, Claude effort lift) with built-in effectiveness tracking so each fix can be retired once it stops firing.",
  "private": true,
  "keywords": ["pi-package", "pi", "pi-extension", "claude", "context", "guard", "fixes"],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/effectiveness.ts",
      "./extensions/context-guard.ts",
      "./extensions/claude-effort.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "license": "MIT"
}
