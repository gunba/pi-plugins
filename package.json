{
  "name": "pi-plugins",
  "version": "0.9.1",
  "description": "Jordan Graham's custom Pi extensions packaged as one auto-updatable Pi package.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./pi-codex-transport/extensions/codex-transport.ts",
      "./pi-usage/extensions/usage.ts",
      "./pi-config/extensions/pi-config.ts",
      "./pi-lazy-skills/extensions/lazy-skills.ts",
      "./pi-tab-title/extensions/tab-title.ts",
      "./pi-resume-search/extensions/resume-search.ts",
      "./pi-system-context/extensions/system-context.ts",
      "./pi-context-ledger/extensions/context-ledger.ts",
      "./pi-memedit/extensions/memedit.ts",
      "./pi-settings-sync/extensions/settings-sync.ts",
      "./pi-clones/extensions/clones.ts",
      "./pi-context-guard/extensions/context-guard.ts"
    ],
    "skills": [
      "./pi-settings-sync/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "js-tiktoken": "^1.0.21",
    "typebox": "^1.1.38"
  }
}
