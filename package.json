{
  "name": "pi-plugins",
  "version": "0.13.2",
  "description": "Custom Pi extensions packaged as one auto-updatable Pi package.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./pi-codex-compat/extensions/codex-compat.ts",
      "./pi-web-search/extensions/web-search.ts",
      "./pi-ask-user/index.ts",
      "./pi-scheduler/extensions/scheduler.ts",
      "./pi-brief/extensions/brief.ts",
      "./pi-extension-freshness/extensions/extension-freshness.ts",
      "./pi-config/extensions/pi-config.ts",
      "./pi-system-context/extensions/system-context.ts",
      "./pi-compaction-context/extensions/compaction-context.ts",
      "./pi-context-ledger/extensions/context-ledger.ts",
      "./pi-goal/extensions/goal.ts",
      "./pi-subagents/extensions/subagents.ts",
      "./pi-todo/extensions/todo.ts",
      "./pi-sync/extensions/pi-sync.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.3",
    "@earendil-works/pi-coding-agent": ">=0.84.3",
    "@earendil-works/pi-tui": ">=0.84.3"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
