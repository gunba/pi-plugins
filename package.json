{
  "name": "pi-plugins",
  "version": "0.10.5",
  "description": "Custom Pi extensions packaged as one auto-updatable Pi package.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension"
  ],
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "test": "node --test pi-codex-compat/tests/*.test.mjs pi-subagents/tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./pi-fixes/extensions/effectiveness.ts",
      "./pi-fixes/extensions/context-guard.ts",
      "./pi-fixes/extensions/claude-effort.ts",
      "./pi-codex-compat/extensions/codex-compat.ts",
      "./pi-file-links/extensions/file-links.ts",
      "./pi-ask-user/index.ts",
      "./pi-scheduler/extensions/scheduler.ts",
      "./pi-usage/extensions/usage.ts",
      "./pi-extension-freshness/extensions/extension-freshness.ts",
      "./pi-config/extensions/pi-config.ts",
      "./pi-session-search/extensions/session-search.ts",
      "./pi-tab-title/extensions/tab-title.ts",
      "./pi-system-context/extensions/system-context.ts",
      "./pi-compaction-context/extensions/compaction-context.ts",
      "./pi-context-ledger/extensions/context-ledger.ts",
      "./pi-memedit/extensions/memedit.ts",
      "./pi-subagents/extensions/subagents.ts",
      "./pi-sync/extensions/pi-sync.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "js-tiktoken": "^1.0.21",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
