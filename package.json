{
  "name": "pi-plugins",
  "version": "0.29.203",
  "description": "Custom Pi extensions packaged as one auto-updatable Pi package.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension"
  ],
  "type": "module",
  "workspaces": [
    "pi-codex-wire"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "test": "node --test --test-concurrency=4",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "prompts": [
      "./pi-prompts/*.md"
    ],
    "extensions": [
      "./pi-session-ownership/index.ts",
      "./pi-desk/extensions/desk.ts",
      "./pi-openai-images/index.ts",
      "./pi-codex-wire/extensions/index.ts",
      "./node_modules/@gotgenes/pi-anthropic-auth/src/index.ts",
      "./pi-message-timestamps/extensions/message-timestamps.ts",
      "./pi-local-links/extensions/local-links.ts",
      "./pi-web-search/extensions/web-search.ts",
      "./pi-ask-user/index.ts",
      "./pi-config/extensions/pi-config.ts",
      "./pi-system-context/extensions/system-context.ts",
      "./pi-session-memory/extensions/session-memory.ts",
      "./pi-conversation-search/index.ts",
      "./pi-fast-footer/extensions/fast-footer.ts",
      "./pi-context-ledger/extensions/context-ledger.ts",
      "./pi-context-window/index.ts",
      "./pi-agents/index.ts",
      "./pi-plan/extensions/plan.ts",
      "./pi-watch/index.ts",
      "./pi-show/extensions/show.ts",
      "./pi-agents/subagents/subagents.ts",
      "./pi-output-budget/extensions/index.ts",
      "./pi-system-one/index.ts",
      "./pi-command-guard/index.ts",
      "./pi-compaction-context/extensions/compaction-context.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@gotgenes/pi-anthropic-auth": "3.4.3",
    "jiti": "2.7.0",
    "mdast-util-from-markdown": "^2.0.2",
    "proper-lockfile": "4.1.2",
    "proxy-agent": "6.5.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
